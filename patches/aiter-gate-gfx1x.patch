+def is_aiter_found_and_supported_on_gfx1x() -> bool:
+    """gfx1x (RDNA 3.5, e.g. gfx1151) analog of
+    `is_aiter_found_and_supported()`.
+
+    Same reasoning as the RDNA4 sibling above: no aiter CK build for
+    gfx1x, so this stays off the gfx9 `@if_aiter_supported` umbrella and
+    reports only that aiter's Triton kernels are usable here.
+    """
+    if current_platform.is_rocm() and IS_AITER_FOUND:
+        from vllm.platforms.rocm import on_gfx1x
+
+        return on_gfx1x()
